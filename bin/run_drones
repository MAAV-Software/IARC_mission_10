#!/bin/bash

set -Eeuo pipefail
set -x

# Parse argument.  $1 is the first argument
case $1 in
  "manager")
    echo "starting manager drone ... "
    python3 drones/run_manager.py
    ;;

  "explorer")
    echo "starting explorer server ..."
    python3 drones/run_explorer.py
    ;;

  *)

    usage
    exit 1
    ;;
esac